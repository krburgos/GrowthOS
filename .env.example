# Supabase (Tech Stack Lockfile §7)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Tech Stack Lockfile §7, amended 2026-09-08 from SendGrid/Nodemailer)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Email account connection OAuth (Tech Stack Lockfile §7)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Generated secrets — human-pasted, never committed (Backend Schema §12, Implementation Plan §2)
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
RESEND_WEBHOOK_SECRET=

# The app's own public base URL, used to build tracking-pixel/click/unsubscribe
# links in campaign emails (Backend Schema §9, Milestone 10). Must match the
# `app_url` Vault secret Postgres uses for the same purpose (§8) — update both
# together if the domain ever changes.
APP_URL=

# GEMINI_API_KEY is intentionally omitted — not needed until the AI
# recommendation engine phase (Tech Stack Lockfile §7).
